APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Payment Gateways
# See docs/payment-gateways.md for what each credential is and how to get it.
###############################################################################

# zarinpal | idpay | digipay
PAYMENT_GATEWAY=zarinpal
PAYMENT_HTTP_TIMEOUT=20
PAYMENT_HTTP_RETRIES=2

# --- ZarinPal ---------------------------------------------------------------
# merchant_id is the 36-character UUID from your ZarinPal panel.
# In sandbox any 36-character string is accepted.
ZARINPAL_ENABLED=true
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_REFERRER_ID=

# --- IDPay ------------------------------------------------------------------
# api_key is the 36-character key from "وب‌سرویس‌های من" in the IDPay dashboard.
# The callback domain must match the one registered on that web service.
IDPAY_ENABLED=true
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# --- DigiPay (UPG) ----------------------------------------------------------
# All four values are issued by DigiPay merchant support. client_id/secret form
# the HTTP Basic header; username/password are the OAuth password-grant body.
DIGIPAY_ENABLED=false
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_SANDBOX=true
# 0 = standard payment gateway (UPG). Other types are BNPL/credit products.
DIGIPAY_TICKET_TYPE=0
DIGIPAY_AGENT=WEB

# SnappPay (instalment) - credentials come from your SnappPay contract
SNAPPPAY_ENABLED=false
SNAPPPAY_BASE_URL=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_SCOPE=online-merchant
SNAPPPAY_AUTO_SETTLE=true
# Instalment window from the contract, in Tomans (0 = no limit)
SNAPPPAY_MIN_AMOUNT=0
SNAPPPAY_MAX_AMOUNT=0
